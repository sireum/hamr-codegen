exit /B %errorlevel%
::!#*/
// #Sireum

// Do not edit this file as it will be overwritten if HAMR codegen is rerun

// Coverage report for one or more HAMR component crates:
//
//   coverage-report.cmd <crate-dir>... [no-run | reuse] [open] [out=<dir>] [<test-name-filter>...]
//
// An argument naming a directory with a Cargo.toml is a crate; any other argument
// that is not an option below is passed on to `cargo test` (e.g. a test name filter).
//
// Runs each crate's unit tests with coverage instrumentation (branch data on), each
// crate's raw profiles going to its own target/coverage/ along with binaries.txt (the
// test executables of that run) and run.txt (its test exit code and test name filters),
// then writes one report over all of them to the
// output directory -- <crate-dir>/target/coverage/ for a single crate; for several,
// target/coverage/ beside this script's bin/ directory (hamr/microkit/target/coverage/),
// or out=<dir>:
//   status.txt          the outcome, one word (see below)
//   lcov.info           llvm-cov's lcov export
//   summary.txt         llvm-cov's per-file summary of the crates' src/ (regions,
//                       functions, lines, branches), which it also prints
//   report/index.html   the HTML report: report.js and report.css (copied from
//                       coverage-report/ beside this script) drawing data.js
// With several crates the profiles are merged, so a source file several crates
// compile (the data crate) is reported once, with their hits combined.
//
//   no-run     do not test: report on each crate's last run.  Refuses (exit 5) when a
//              crate has no run, was last run with other test name filters (normally:
//              with any), or its sources or test executables changed since, since
//              llvm-cov would then drop or misplace the changed code's counts.  A last
//              run whose tests failed still counts, and makes the outcome tests-failed
//   reuse      test only the crates whose last run is missing, out of date, filtered
//              differently or failing; report on the others' last runs
//   open       open the report in the browser afterwards (unless HAMR_NO_BROWSER is set,
//              as for unattended runs)
//   out=<dir>  where to write the report
//
// Outcome, in status.txt in the output directory (`sireum slang run` turns every
// non-zero exit into the same code, so callers read this file to tell the cases apart;
// the exit code is 0 only for ok):
//   ok             the tests passed (or none were run) and the report was written
//   tests-failed   some tests failed or did not build (with no-run: in a crate's last
//                  run); the report is still written from the crates that produced data
//   no-coverage    the toolchain's llvm-tools-preview component is missing; nothing
//                  was run, so a caller can fall back to plain `cargo test`
//   report-failed  the tests passed, but the report could not be built
//   stale          no-run, and a crate's last run is missing, out of date or filtered
//                  differently
//
// Needs only cargo, the toolchain's llvm-tools-preview component, and Sireum; every
// command runs without a shell, so it works the same on Linux, macOS and Windows.

import org.sireum._

val assetsDir: Os.Path = Os.slashDir / "coverage-report"

// Record the outcome in <covDir>/status.txt and return the exit code for it.
def finish(covDir: Os.Path, status: String, code: Z): Z = {
  covDir.mkdirAll()
  (covDir / "status.txt").writeOver(s"$status\n")
  return code
}

def exe(name: String): String = {
  return if (Os.isWin) s"$name.exe" else name
}

def usage(): Unit = {
  println("Usage: coverage-report.cmd <crate-dir>... [no-run | reuse] [open] [out=<dir>] [<test-name-filter>...]")
}

// The deepest directory containing every given directory (whole path segments).
def commonDir(dirs: ISZ[Os.Path]): Os.Path = {
  var common = dirs(0)
  for (d <- dirs) {
    while (d.string != common.string && !ops.StringOps(d.string).startsWith(s"${common.string}${Os.fileSep}")) {
      common = common.up
    }
  }
  return common
}

// The llvm-tools-preview binaries of the toolchain the crate's rust-toolchain.toml
// selects: <sysroot>/lib/rustlib/<host>/bin.
def llvmToolsDir(crate: Os.Path): Option[Os.Path] = {
  val sysroot = Os.proc(ISZ("rustc", "--print", "sysroot")).at(crate).run()
  val vv = Os.proc(ISZ("rustc", "-vV")).at(crate).run()
  if (!sysroot.ok || !vv.ok) {
    return None()
  }
  var host: String = ""
  for (line <- ops.StringOps(vv.out).split((c: C) => c == '\n')) {
    val t = ops.StringOps(line).trim
    if (ops.StringOps(t).startsWith("host: ")) {
      host = ops.StringOps(t).substring(6, t.size)
    }
  }
  if (host == "") {
    return None()
  }
  val dir = Os.path(ops.StringOps(sysroot.out).trim) / "lib" / "rustlib" / host / "bin"
  return if ((dir / exe("llvm-cov")).exists && (dir / exe("llvm-profdata")).exists) Some(dir) else None()
}

// The environment of an instrumented test build.  -Zcoverage-options=branch makes
// rustc record which way each `if` condition went (without it there is no branch
// data); RUSTC_BOOTSTRAP=1 lets the pinned stable toolchain accept it and the data
// crate's feature gates.
def coverageEnv(covDir: Os.Path): ISZ[(String, String)] = {
  return ISZ(
    ("RUSTC_BOOTSTRAP", "1"),
    ("CARGO_INCREMENTAL", "0"),
    ("RUSTFLAGS", "-Cinstrument-coverage -Zcoverage-options=branch"),
    ("LLVM_PROFILE_FILE", (covDir / "cargo-test-%p-%m.profraw").string))
}

// The test executables of the instrumented build, as cargo reports them (built with
// the same flags as the test run, so cargo reuses that build).  Called only right
// after a test run: afterwards it could rebuild them from changed sources.
def testBinaries(crate: Os.Path, env: ISZ[(String, String)]): ISZ[String] = {
  val r = Os.proc(ISZ("cargo", "test", "--no-run", "--message-format=json")).env(env).at(crate).run()
  val key: String = "\"executable\":\""
  var bins = ISZ[String]()
  for (line <- ops.StringOps(r.out).split((c: C) => c == '\n')) {
    val i = ops.StringOps(line).stringIndexOf(key)
    if (i >= 0) {
      val rest = ops.StringOps(line).substring(i + key.size, line.size)
      val j = ops.StringOps(rest).indexOf('"')
      if (j > 0) {
        // JSON escapes a Windows path's backslashes
        bins = bins :+ ops.StringOps(ops.StringOps(rest).substring(0, j)).replaceAllLiterally("\\\\", "\\")
      }
    }
  }
  return bins
}

def crateCovDir(crate: Os.Path): Os.Path = {
  return crate / "target" / "coverage"
}

def profraws(crate: Os.Path): ISZ[String] = {
  val dir = crateCovDir(crate)
  return if (!dir.exists) ISZ() else for (f <- dir.list if ops.StringOps(f.name).endsWith(".profraw")) yield f.string
}

// The local files listed in a Makefile-style dep-info file (target: dep dep ...), as
// rustc writes beside each artifact; spaces in paths are escaped as "\ ".  rustc
// runs in the crate's directory, so its own sources are listed relative to the crate.
// The registry's, rustup's and the standard library's sources, which do not change,
// are left out, and so are files under the crate's target/ (code a build script
// generates, from inputs tracked here; a later build with other flags may regenerate
// it without anything having changed).
def depInfoFiles(crate: Os.Path, d: Os.Path): ISZ[Os.Path] = {
  var r = ISZ[Os.Path]()
  for (line <- d.readLines if !ops.StringOps(line).startsWith("#")) {
    val i = ops.StringOps(line).stringIndexOf(": ")
    if (i >= 0) {
      val deps = ops.StringOps(line).substring(i + 2, line.size)
      // a backslash-space becomes NUL while splitting at spaces, then a space again
      val words: ISZ[String] =
        if (ops.StringOps(deps).stringIndexOf("\\ ") < 0) ops.StringOps(deps).split((c: C) => c == ' ')
        else for (w <- ops.StringOps(ops.StringOps(deps).replaceAllLiterally("\\ ", "\u0000")).split((c: C) => c == ' '))
          yield ops.StringOps(w).replaceAllChars('\u0000', ' ')
      for (f <- words if f != "") {
        val u = ops.StringOps(ops.StringOps(f).replaceAllChars('\\', '/'))
        if (!u.contains("/.cargo/") && !u.contains("/.rustup/") && !u.contains("/rustlib/")) {
          val q = Os.path(f)
          val abs: Os.Path = if (q.isAbs) q else crate / f
          if (!ops.StringOps(abs.string).startsWith(s"${(crate / "target").string}${Os.fileSep}")) {
            r = r :+ abs
          }
        }
      }
    }
  }
  return r
}

// The files a crate's test executables are built from: every local source the dep-info
// files of its build list (the crate's own and its path dependencies', such as the data
// crate's -- cargo puts them in target/debug/deps/ or, with the newer build directory
// layout, in target/debug/build/<package>/<hash>/out/), plus the crate's Cargo.toml and
// build.rs, and the data crate's Cargo.toml.  Without dep-info, the crate's and the
// data crate's src/.  Not Cargo.lock: cargo rewrites it during a run, after linking, and
// it names only registry and git dependencies, whose sources are not reported.
def sourcesOf(crate: Os.Path, bins: ISZ[String]): ISZ[Os.Path] = {
  var r = ISZ[Os.Path](crate / "Cargo.toml", crate / "build.rs", crate.up / "data" / "Cargo.toml")
  var dirs = HashSSet.empty[String] + (crate / "target" / "debug").string
  for (b <- bins) {
    dirs = dirs + Os.path(b).up.string
  }
  var depInfos = HashSSet.empty[String]
  for (dir <- dirs.elements if Os.path(dir).exists) {
    for (d <- Os.Path.walk(Os.path(dir), F, F, (p: Os.Path) => ops.StringOps(p.name).endsWith(".d") && p.isFile)) {
      depInfos = depInfos + d.string
    }
  }
  if (depInfos.isEmpty) {
    for (d <- ISZ(crate / "src", crate.up / "data" / "src") if d.exists) {
      r = r ++ Os.Path.walk(d, F, F, (p: Os.Path) => p.isFile)
    }
  }
  for (d <- depInfos.elements) {
    r = r ++ depInfoFiles(crate, Os.path(d))
  }
  return r
}

// The record of a crate's run: its test exit code and the test name filters it ran with.
def runRecord(exitCode: Z, filters: ISZ[String]): String = {
  return st"""exit=$exitCode
             |${(for (f <- filters) yield st"filter=$f", "\n")}""".render
}

// A crate's last run, if it is still valid: the test executables binaries.txt records
// (written right after the run) and the run's test exit code, as long as the run had
// the same test name filters, no source is newer than the oldest of the executables (a
// source changed after they were built; a source written in the same timestamp tick
// counts as newer), and none of them is newer than binaries.txt (rebuilt after the
// run).  Otherwise llvm-cov would read the old profiles against new code and drop or
// misplace its counts, or a filtered run would pass for a full one.
def lastRun(crate: Os.Path, filters: ISZ[String]): Either[(ISZ[String], Z), String] = {
  val record = crateCovDir(crate) / "binaries.txt"
  val runFile = crateCovDir(crate) / "run.txt"
  if (!record.exists || !runFile.exists || profraws(crate).isEmpty) {
    return Either.Right("no coverage run")
  }
  var exitCode: Z = -1
  var ranWith = ISZ[String]()
  for (l <- runFile.readLines) {
    val t = ops.StringOps(l).trim
    if (ops.StringOps(t).startsWith("exit=")) {
      exitCode = Z(ops.StringOps(t).substring(5, t.size)).getOrElse(-1)
    } else if (ops.StringOps(t).startsWith("filter=")) {
      ranWith = ranWith :+ ops.StringOps(t).substring(7, t.size)
    }
  }
  if (ranWith != filters) {
    return Either.Right(
      if (ranWith.isEmpty) "its last run was not filtered"
      else s"its last run was filtered (${st"${(ranWith, " ")}".render})")
  }
  val bins = for (l <- record.readLines if ops.StringOps(l).trim != "") yield ops.StringOps(l).trim
  if (bins.isEmpty) {
    return Either.Right("no test executables recorded")
  }
  var oldestBin = record.lastModified
  for (b <- bins) {
    val p = Os.path(b)
    if (!p.exists) {
      return Either.Right(s"test executable $b is gone")
    }
    if (p.lastModified > record.lastModified) {
      return Either.Right("its test executables were rebuilt after the run")
    }
    if (p.lastModified < oldestBin) {
      oldestBin = p.lastModified
    }
  }
  for (src <- sourcesOf(crate, bins) if src.exists && src.lastModified >= oldestBin) {
    return Either.Right(s"${crate.up.relativize(src)} changed after the run")
  }
  return Either.Left((bins, exitCode))
}

def run(args: ISZ[String]): Z = {
  var crates = ISZ[Os.Path]()
  var noRun: B = F
  var reuse: B = F
  var openReport: B = F
  var outOpt: Option[Os.Path] = None()
  var filters = ISZ[String]()
  for (a <- args) {
    if (a == "no-run") {
      noRun = T
    } else if (a == "reuse") {
      reuse = T
    } else if (a == "open") {
      openReport = T
    } else if (ops.StringOps(a).startsWith("out=")) {
      outOpt = Some(Os.path(ops.StringOps(a).substring(4, a.size)).canon)
    } else if ((Os.path(a) / "Cargo.toml").exists) {
      crates = crates :+ Os.path(a).canon
    } else {
      filters = filters :+ a
    }
  }
  if (crates.isEmpty || (noRun && reuse)) {
    usage()
    eprintln(if (crates.isEmpty) "No crate directory (a directory with a Cargo.toml) was given." else "no-run and reuse exclude each other.")
    return 2
  }
  val covDir: Os.Path = outOpt match {
    case Some(d) => d
    case _ => if (crates.size == 1) crates(0) / "target" / "coverage" else Os.slashDir.up / "target" / "coverage"
  }

  // the generated crates all pin the same toolchain, so the first crate's llvm-tools serve
  val tools: Os.Path = llvmToolsDir(crates(0)) match {
    case Some(d) => d
    case _ =>
      eprintln("Coverage unavailable: llvm-cov not found for this crate's toolchain.  Install it with:")
      eprintln("  rustup component add llvm-tools-preview")
      return finish(covDir, "no-coverage", 3)
  }

  // with no-run, every crate needs a valid last run
  if (noRun) {
    var stale = ISZ[String]()
    for (crate <- crates) {
      lastRun(crate, filters) match {
        case Either.Right(why) => stale = stale :+ s"${crate.name}: $why"
        case _ =>
      }
    }
    if (stale.nonEmpty) {
      eprintln("Cannot report without re-testing (no-run):")
      for (s <- stale) {
        eprintln(s"  $s")
      }
      eprintln("Run again without no-run, or with reuse to re-test only these crates.")
      return finish(covDir, "stale", 5)
    }
  }

  var testExit: Z = 0
  var raws = ISZ[String]()
  var bins = ISZ[String]()
  var reported = ISZ[Os.Path]()
  for (crate <- crates) {
    val crateCov = crateCovDir(crate)
    val env = coverageEnv(crateCov)
    val prior: Either[(ISZ[String], Z), String] = if (noRun || reuse) lastRun(crate, filters) else Either.Right("")
    prior match {
      // reuse re-tests a run whose tests failed, so their output is shown again
      case Either.Left((recorded, code)) if noRun || code == 0 =>
        if (reuse) {
          println(s"== ${crate.name}: reusing its last coverage run")
        }
        if (code != 0) {
          eprintln(s"== ${crate.name}: its last run's tests failed (exit $code)")
          if (testExit == 0) {
            testExit = code
          }
        }
        raws = raws ++ profraws(crate)
        bins = bins ++ recorded
        reported = reported :+ crate
      case _ =>
        val why: String = prior match {
          case Either.Right(w) => w
          case _ => "its last run's tests failed"
        }
        if (crates.size > 1 || reuse) {
          println(if (reuse) s"== ${crate.name}: testing ($why)" else s"== ${crate.name}")
        }
        crateCov.removeAll()
        crateCov.mkdirAll()
        val code = Os.proc(ISZ[String]("cargo", "test") ++ filters).env(env).at(crate).console.run().exitCode
        if (testExit == 0) {
          testExit = code
        }
        val crateBins = testBinaries(crate, env)
        val crateRaws = profraws(crate)
        if (crateBins.isEmpty || crateRaws.isEmpty) {
          eprintln(s"Warning: no coverage data for ${crate.name} (its tests did not build or run); it is left out of the report")
        } else {
          (crateCov / "binaries.txt").writeOver(st"${(crateBins, "\n")}".render)
          (crateCov / "run.txt").writeOver(runRecord(code, filters))
          raws = raws ++ crateRaws
          bins = bins ++ crateBins
          reported = reported :+ crate
        }
    }
  }
  // no report: tests-failed if they did, else report-failed
  def reportFailed(): Z = {
    return if (testExit != 0) finish(covDir, "tests-failed", testExit) else finish(covDir, "report-failed", 4)
  }
  if (reported.isEmpty) {
    eprintln("No coverage data: the tests did not build or did not run.")
    return reportFailed()
  }
  covDir.mkdirAll()
  val profdata = covDir / "coverage.profdata"
  val merge = Os.proc(ISZ[String]((tools / exe("llvm-profdata")).string, "merge", "-sparse") ++ raws ++
    ISZ[String]("-o", profdata.string)).at(covDir).run()
  if (!merge.ok) {
    eprintln("llvm-profdata merge failed:")
    eprintln(merge.err)
    return reportFailed()
  }

  // llvm-cov arguments: the profile, the test executables (the first one plain, the
  // rest with -object), and dependencies' and the standard library's sources left out
  var covArgs = ISZ[String](s"-instr-profile=${profdata.string}", "-ignore-filename-regex=[/\\\\](\\.cargo|rustc|rustlib)[/\\\\]")
  for (i <- bins.indices) {
    covArgs = if (i == 0) covArgs :+ bins(i) else covArgs ++ ISZ[String]("-object", bins(i))
  }
  val llvmCov = (tools / exe("llvm-cov")).string
  val lcov = Os.proc(ISZ[String](llvmCov, "export", "-format=lcov") ++ covArgs).at(covDir).run()
  val json = Os.proc(ISZ[String](llvmCov, "export", "-format=text", "-skip-functions") ++ covArgs).at(covDir).run()
  val summary = Os.proc(ISZ[String](llvmCov, "report", "-show-branch-summary") ++ covArgs ++
    (for (c <- reported) yield (c / "src").string)).at(covDir).run()
  if (!lcov.ok || !json.ok || !summary.ok) {
    eprintln("llvm-cov failed:")
    eprintln(lcov.err)
    eprintln(json.err)
    eprintln(summary.err)
    return reportFailed()
  }
  (covDir / "lcov.info").writeOver(lcov.out)
  // the per-file summary of the crates' own sources, printed and kept for bin/build.cmd
  (covDir / "summary.txt").writeOver(summary.out)

  // the source text of every file the export covers, keyed by its name in the export
  var sources = ISZ[ST]()
  for (line <- ops.StringOps(lcov.out).split((c: C) => c == '\n') if ops.StringOps(line).startsWith("SF:")) {
    val name = ops.StringOps(ops.StringOps(line).substring(3, line.size)).trim
    val p = Os.path(name)
    if (p.isFile) {
      sources = sources :+ st"${Json.Printer.printString(name)}: ${Json.Printer.printString(p.read)}"
    }
  }

  val reportDir = covDir / "report"
  reportDir.removeAll()
  reportDir.mkdirAll()
  for (asset <- ISZ("index.html", "report.js", "report.css")) {
    (assetsDir / asset).copyOverTo(reportDir / asset)
  }
  // paths in the report are shown relative to the crates' common parent (crates/)
  val root: Os.Path = if (reported.size == 1) reported(0).up else commonDir(reported)
  // llvm-cov's JSON export is one line of JSON, which is also a JavaScript literal
  val data =
    st"""window.HAMR_COVERAGE = {
        |crate: ${Json.Printer.printString(st"${(for (c <- reported) yield c.name, ", ")}".render)},
        |root: ${Json.Printer.printString(root.string)},
        |date: ${extension.Time.currentMillis},
        |lcov: ${Json.Printer.printString(lcov.out)},
        |llvm: ${ops.StringOps(json.out).trim},
        |sources: {
        |${(sources, ",\n")}
        |}
        |};
        |"""
  (reportDir / "data.js").writeOver(data.render)

  println()
  print(summary.out)
  println()
  println(s"Report: ${(reportDir / "index.html").toUri}")
  if (openReport && Os.env("HAMR_NO_BROWSER").isEmpty) {
    if (Os.isWin) {
      Os.proc(ISZ("cmd", "/c", "start", "", (reportDir / "index.html").string)).run()
    } else if (Os.isMac) {
      Os.proc(ISZ("open", (reportDir / "index.html").string)).run()
    } else {
      Os.proc(ISZ("xdg-open", (reportDir / "index.html").string)).run()
    }
  }
  return if (testExit != 0) finish(covDir, "tests-failed", testExit) else finish(covDir, "ok", 0)
}

Os.exit(run(Os.cliArgs))
